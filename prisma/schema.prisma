// Provider configuration (org or platform scope, encrypted keys)
model AiModelConfig {
  id              String       @id @default(cuid())
  orgId           String? // null = platform default
  providerCode    String // openai | anthropic | google | demo
  label           String
  baseUrl         String? // OpenAI-compatible override (Groq/OpenRouter/Azure/Ollama…)
