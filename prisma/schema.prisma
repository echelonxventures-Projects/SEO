model SiteAuditIssue {
  id        String   @id @default(cuid())
  auditId   String
  checkCode String
  category  String
  severity  Severity
  message   String
  detail    Json?

  audit SiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, severity])
}

// ---------------------------------------------------------------------------
// Campaigns & metrics
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  SCHEDULED
  LIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Campaign {
  id             String            @id @default(cuid())
  orgId          String
  projectId      String?
  clientId       String? // null = workspace's own house campaign (self-serve)
  channelId      String? // legacy category channel (kept nullable for history)
  mediaChannelId String? // primary channel entity
  audienceId     String? // default target base for the campaign
  name           String
  status         CampaignStatus    @default(DRAFT)
  lifecycle      CampaignLifecycle @default(DRAFT)
  composition    Json?
  plannedAt      DateTime?
  approvedAt     DateTime?
  launchedAt     DateTime?
  closedAt       DateTime?
  learnedAt      DateTime?
  startDate      DateTime?
  endDate        DateTime?
  budgetMinor    BigInt?
  currencyCode   String
  externalRef    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  org            Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project        Project?          @relation(fields: [projectId], references: [id])
  client         Client?           @relation(fields: [clientId], references: [id])
  channel        Category?         @relation(fields: [channelId], references: [id])
  mediaChannel   Channel?          @relation("CampaignPrimaryChannel", fields: [mediaChannelId], references: [id])
  audience       Audience?         @relation("CampaignAudience", fields: [audienceId], references: [id])
  currency       Currency          @relation(fields: [currencyCode], references: [code])
  metrics        CampaignMetric[]
  contentPosts   ContentPost[]
  trackedLinks   TrackedLink[]
  emailCampaigns EmailCampaign[]
  adCreatives    AdCreative[]
  flights        CampaignFlight[]
  offersLink     CampaignOffer[]
  triggers       ScheduleTrigger[]

  // UCIP composition layer (restored from migrations)
  attributionResults    AttributionResult[]
  attributionTouches    AttributionTouch[]
  autonomousPolicys     AutonomousPolicy[]
  budgetPlan            BudgetPlan?
  campaignVersions      CampaignVersion[]
  channelOptimizations  ChannelOptimization[]
  conversionPredictions ConversionPrediction[]
  experiments           Experiment[]
  journeys              Journey[]
  optimizationRuns      OptimizationRun[]
  outcomeEvents         OutcomeEvent[]
  predictiveScores      PredictiveScore[]

  @@index([orgId, status])
  @@index([clientId])
}

model CampaignMetric {
  id           String   @id @default(cuid())
  campaignId   String
  orgId        String
  date         DateTime
  impressions  BigInt   @default(0)
  clicks       BigInt   @default(0)
  costMinor    BigInt   @default(0)
  conversions  BigInt   @default(0)
  revenueMinor BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([orgId, date])
}

// ---------------------------------------------------------------------------
// Reporting, monitoring & audit trail
// ---------------------------------------------------------------------------

enum ReportModule {
  REVENUE
  CLIENTS
  SEO_RANKINGS
  CAMPAIGNS
  TIMESHEETS
  TEAM
}

enum ReportSchedule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Report {
  id              String         @id @default(cuid())
  orgId           String
  name            String
  module          ReportModule
  definition      Json
  schedule        ReportSchedule @default(NONE) // legacy; superseded by patternId when set
  patternId       String? // UTP temporal asset — the report's recurring schedule
  lastScheduledAt DateTime? // last materialized slot the cron executed for
  nextScheduledAt DateTime? // monitoring: upcoming run (computed, cron-maintained)
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  org     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pattern TemporalPattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)
  runs    ReportRun[]

  @@index([orgId, module])
  @@index([nextScheduledAt])
}

model ReportRun {
  id                String   @id @default(cuid())
  reportId          String
  ranAt             DateTime @default(now())
  triggeredByUserId String
  resultSummary     Json

  report      Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  triggeredBy User   @relation(fields: [triggeredByUserId], references: [id])

  @@index([reportId, ranAt])
}

model ActivityLog {
  id         String          @id @default(cuid())
  orgId      String?
  userId     String?
  action     String
  entityType NoteEntityType?
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime        @default(now())

  org  Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
  @@index([action])
}

model RateLimitBucket {
  id           String   @id @default(cuid())
  bucketKey    String   @unique
  tokens       Float
  maxTokens    Float
  refillPerSec Float
  updatedAt    DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     Json
  valueType String   @default("json")
  updatedAt DateTime @updatedAt
}

// ===========================================================================
// MARKETING EXECUTION SUITE
// ===========================================================================

// --- Social channels & connections ----------------------------------------

enum SocialConnectionStatus {
  CONNECTED
  TOKEN_EXPIRED
  ERROR
  DISCONNECTED
}

model SocialAppConfig {
  id           String @id @default(cuid())
  orgId        String
  connectorKey String // → ConnectorTemplate.key (soft cross-module ref)

  clientId        String
  clientSecretEnc Json
  scopes          String[]

  // Optional protocol overrides — empty = the adapter's built-in provider
  // defaults. Filled in = version bumps, regional hosts or API gateways
  // become configuration instead of code changes.
  authorizeUrl String?
  tokenUrl     String?
  apiBase      String?
  extraHeaders Json? // { "Header": "value" } string map merged into API calls
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, connectorKey])
  @@index([orgId, active])
}

model SocialConnection {
  id                String                 @id @default(cuid())
  orgId             String
  clientId          String?
  connectorKey      String // → ConnectorTemplate.key (soft cross-module ref)
  externalAccountId String
  handle            String
  displayName       String?
  profilePictureUrl String?
  accessTokenEnc    Json
  refreshTokenEnc   Json?
  tokenExpiresAt    DateTime?
  scopes            String[]
  status            SocialConnectionStatus @default(CONNECTED)
  lastError         String?
  lastCheckedAt     DateTime?
  connectedById     String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client  Client?         @relation(fields: [clientId], references: [id])
  targets ContentTarget[]

  @@unique([orgId, connectorKey, externalAccountId])
  @@index([orgId, status])
}

model OAuthPending {
  id           String    @id @default(cuid())
  orgId        String
  connectorKey String
  stateHash    String    @unique
  verifierEnc  Json?
  redirectTo   String?
  userId       String
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([expiresAt])
}

// --- Content & scheduling ---------------------------------------------------

enum ContentPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  CANCELLED
}

enum ContentTargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  SKIPPED
}

model ContentPost {
  id           String            @id @default(cuid())
  orgId        String
  clientId     String?
  projectId    String?
  campaignId   String?
  title        String
  body         String
  linkUrl      String?
  media        Json? // [{ url, alt }] — publicly reachable media URLs
  tags         String[]
  hashtags     String[]
  stage        ContentStage      @default(IDEATION)
  kindId       String?
  customFields Json?
  status       ContentPostStatus @default(DRAFT)
  source       PublishSource     @default(MANUAL)
  createdById  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client    Client?         @relation(fields: [clientId], references: [id])
  project   Project?        @relation(fields: [projectId], references: [id])
  campaign  Campaign?       @relation(fields: [campaignId], references: [id])
  kind      ContentKind?    @relation(fields: [kindId], references: [id])
  createdBy User            @relation("ContentCreator", fields: [createdById], references: [id])
  targets   ContentTarget[]

  // UCIP composition layer (restored from migrations)
  contentScores       ContentScore[]
  contentTranslations ContentTranslation[]
  contentVersions     ContentVersion[]

  @@index([orgId, status, updatedAt])
}

model ContentTarget {
  id             String              @id @default(cuid())
  postId         String
  connectionId   String
  orgId          String
  scheduledAt    DateTime
  status         ContentTargetStatus @default(PENDING)
  attempts       Int                 @default(0)
  publishedAt    DateTime?
  externalPostId String?
  externalUrl    String?
  lastError      String?
  responseMeta   Json?

  post       ContentPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  connection SocialConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  org        Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  logs       ContentPublishLog[]

  @@unique([postId, connectionId])
  @@index([status, scheduledAt])
  @@index([orgId])
}

enum PublishOutcome {
  SUCCESS
  FAILED
  SKIPPED
}

model ContentPublishLog {
  id       String         @id @default(cuid())
  targetId String
  outcome  PublishOutcome
  message  String?
