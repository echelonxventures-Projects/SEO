enum ChannelKind {
  SEARCH
  SOCIAL
  DISPLAY
  VIDEO
  EMAIL
  WHATSAPP
  SMS
  AFFILIATE
  ORGANIC
  DIRECT_MAIL
  MARKETPLACE
}

enum ChannelCostModel {
  CPC
  CPM
  CPA
  FLAT
  FREE
}

model Channel {
  id                 String           @id @default(cuid())
  orgId              String? // null = platform default channel catalog
  code               String // GOOGLE_ADS, META_ADS…
  name               String
  kind               ChannelKind
  description        String?
  costModel          ChannelCostModel @default(CPC)
  capabilities       String[] // audience, scheduling, creative, tracking, publish
  requiresConnection Boolean          @default(false) // readiness = live connection for this kind
  connectorKey       String? // for kind=SOCIAL: which connector powers publishing here
  utmMedium          String           @default("paid")
  budgetCapMinor     BigInt? // org policy cap per flight
  active             Boolean          @default(true)
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  org       Organization?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaigns Campaign[]        @relation("CampaignPrimaryChannel")
  triggers  ScheduleTrigger[]
  flights   CampaignFlight[]

  @@unique([orgId, code])
  @@index([active, sortOrder])
}

enum AudienceKind {
  CUSTOMER_LIST
  PROSPECT_LIST
  WEBSITE_VISITORS
  SOCIAL_FOLLOWERS
  EVENT_ATTENDEES
  LOOKALIKE_SEED
  SEGMENT
}

enum AudienceSource {
  CSV_UPLOAD
  MANUAL
  MAILING_LIST_REF
  FORM_IMPORT
}

enum AudienceStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ConsentStatus {
  OPT_IN
  IMPORTED_LEGACY
  EXPIRED
}

model Audience {
  id           String         @id @default(cuid())
  orgId        String
  clientId     String?
  name         String
  description  String?
  kind         AudienceKind   @default(CUSTOMER_LIST)
  source       AudienceSource @default(MANUAL)
  status       AudienceStatus @default(ACTIVE)
  sourceListId String? // when source=MAILING_LIST_REF
  criteria     Json? // for SEGMENT: {tag, clientId…} resolved at send time
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client     Client?          @relation(fields: [clientId], references: [id])
  sourceList MailingList?     @relation("AudienceSourceList", fields: [sourceListId], references: [id])
  members    AudienceMember[]
  segments   Segment[]
  flights    CampaignFlight[]
  campaigns  Campaign[]       @relation("CampaignAudience")

