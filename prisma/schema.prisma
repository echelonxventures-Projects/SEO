  // A date range or time range asset. When relativeKind is set, start/end are
  // computed from a reference instant; otherwise absoluteDate/absoluteTime win.
  startDate     DateTime?
  endDate       DateTime?
  startTime     String? // "09:00"
  endTime       String? // "18:00"
  relativeDir   String? // BEFORE|AFTER|AROUND
  relativeValue Int? // magnitude
  relativeUnit  String? // SECONDS|MINUTES|HOURS|DAYS|WEEKS|MONTHS|QUARTERS|YEARS
  allDay        Boolean   @default(true)
  timezone      String    @default("Asia/Kolkata")
  createdById   String
