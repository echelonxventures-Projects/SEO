  projectId       String?
  sourceUrl       String
  targetUrl       String
  anchorText      String?
  dofollow        Boolean        @default(true)
  domainAuthority Int?
  status          BacklinkStatus @default(LIVE)
  firstSeenAt     DateTime       @default(now())
  lastCheckedAt   DateTime?
  notes           String?
  updatedAt       DateTime       @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, sourceUrl, targetUrl])
  @@index([orgId, status])
}

enum AuditStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum Severity {
  CRITICAL
  ERROR
  WARNING
  NOTICE
  PASS
}

model SiteAudit {
  id            String      @id @default(cuid())
  orgId         String
  projectId     String?
  url           String
  status        AuditStatus @default(QUEUED)
  score         Int?
  passedCount   Int         @default(0)
  issueCount    Int         @default(0)
  startedAt     DateTime    @default(now())
  finishedAt    DateTime?
  error         String?
  summary       Json?
  requestedById String

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestedBy User             @relation("AuditRequester", fields: [requestedById], references: [id])
