// OmniMark — Digital Marketing Platform
// Data contract: entities, context, relationships.
// Money = BigInt minor units; quantities = Int x 100; rates = basis points.
// No floats for money anywhere; no business configuration hardcoded in code.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  emailNormalized   String     @unique
  name              String
  passwordHash      String?
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  isPlatformAdmin   Boolean    @default(false)
  lastLoginAt       DateTime?
  totpSecretEnc     Json?
  totpEnabledAt     DateTime?
  /// Last TOTP time step accepted at login — codes at or before it are replays.
  totpLastStep      Int?
  recoveryCodesHash String[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions            Session[]
  memberships         Membership[]
  invitedBy           Invitation[]    @relation("InvitedBy")
  acceptedInvitations Invitation[]    @relation("InvitationRecipient")
  apiKeys             ApiKey[]
  activityLogs        ActivityLog[]
  notesCreated        Note[]          @relation("NoteAuthor")
  createdClients      Client[]        @relation("ClientOwner")
  createdProjects     Project[]       @relation("ProjectOwner")
  assignedTasks       Task[]          @relation("TaskAssignee")
  loggedTime          TimeEntry[]
  approvedQuotes      Quote[]         @relation("QuoteApprover")
  createdQuotes       Quote[]         @relation("QuoteCreator")
  createdInvoices     Invoice[]       @relation("InvoiceCreator")
  recordedPayments    Payment[]       @relation("PaymentRecorder")
  reportRuns          ReportRun[]
  siteAuditsRequested SiteAudit[]     @relation("AuditRequester")
  projectMemberships  ProjectMember[]
  generationJobs      GenerationJob[] @relation("JobCreator")
  blogPosts           BlogPost[]      @relation("BlogCreator")
  adCreatives         AdCreative[]    @relation("AdCreator")
  contentPosts        ContentPost[]   @relation("ContentCreator")

  @@index([status])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  csrfSecret String
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum OtpPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model OtpToken {
  id         String     @id @default(cuid())
  purpose    OtpPurpose
  subject    String
  codeHash   String     @unique
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([purpose, subject])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id              String           @id @default(cuid())
  orgId           String
  email           String
  emailNormalized String
  roleCode        String
  invitedById     String
  acceptedById    String?
  status          InvitationStatus @default(PENDING)
  tokenHash       String           @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy  User         @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy User?        @relation("InvitationRecipient", fields: [acceptedById], references: [id])

  @@unique([orgId, emailNormalized, roleCode])
  @@index([status])
}

model ApiKey {
  id              String    @id @default(cuid())
  orgId           String
  name            String
  prefix          String
  keyHash         String    @unique
  scopes          String[]
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdByUserId String

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdByUserId], references: [id])

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Organizations, Roles, Permissions
// ---------------------------------------------------------------------------

enum OrgStatus {
  ACTIVE
  TRIALING
  SUSPENDED
  CANCELLED
}

model Organization {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  status              OrgStatus @default(TRIALING)
  defaultCurrencyCode String    @default("INR")
  timezone            String    @default("Asia/Kolkata")
  locale              String    @default("en-IN")
  state               String?
  country             String    @default("IN")
  addressLine1        String?
  addressLine2        String?
  city                String?
  postalCode          String?
  gstin               String?
  taxIdType           String?
  phone               String?
  email               String?
  website             String?
  logoUrl             String?
  billingEmail        String?
  trialEndsAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  defaultCurrency     Currency                 @relation("OrgDefaultCurrency", fields: [defaultCurrencyCode], references: [code])
  memberships         Membership[]
  clients             Client[]
  leads               Lead[]
  projects            Project[]
  tasks               Task[]
  timeEntries         TimeEntry[]
  expenses            Expense[]
  notes               Note[]
  serviceItems        ServiceItem[]
  quotes              Quote[]
  invoices            Invoice[]
  tenantInvoices      Invoice[]                @relation("TenantBilling")
  payments            Payment[]
  refunds             Refund[]
  taxRates            TaxRate[]
  categories          Category[]
  pipelineStages      PipelineStage[]
  documentSequences   DocumentSequence[]
  keywords            Keyword[]                @relation("KeywordOrg")
  rankSnapshots       RankSnapshot[]
  geoLocations        GeoLocation[]
  backlinks           Backlink[]
  siteAudits          SiteAudit[]
  campaigns           Campaign[]
  campaignMetrics     CampaignMetric[]
  reports             Report[]
  activityLogs        ActivityLog[]
  apiKeys             ApiKey[]
  invitations         Invitation[]
  subscriptions       Subscription[]
  gateways            GatewayConfig[]
  socialAppConfigs    SocialAppConfig[]
  socialConnections   SocialConnection[]
  contentPosts        ContentPost[]
  contentTargets      ContentTarget[]
  trackedLinks        TrackedLink[]
  channels            Channel[]
  audiences           Audience[]
  campaignFlights     CampaignFlight[]
  audienceMembers     AudienceMember[]
  connectorTemplates  ConnectorTemplate[]      @relation("ConnectorTemplateOrg")
  eventSubscriptions  EventSubscription[]
  offers              Offer[]
  offerRedemptions    OfferRedemption[]
  learnings           LearningsSnapshot[]
  webProperties       WebProperty[]
  trackingPixels      TrackingPixel[]
  mailingLists        MailingList[]
  subscribers         Subscriber[]
  emailCampaigns      EmailCampaign[]
  pixelTemplates      PixelTemplate[]
  aiModelConfigs      AiModelConfig[]
  idempotencyRecords  IdempotencyRecord[]
  tags                Tag[]
  contentKinds        ContentKind[]
  segments            Segment[]
  scheduleTriggers    ScheduleTrigger[]
  customFieldDefs     CustomFieldDef[]
  onboardingSteps     OnboardingStep[]
  onboardingTemplates OnboardingTemplateStep[]
  promptTemplates     PromptTemplate[]
  brandVoices         BrandVoice[]
  generationJobs      GenerationJob[]
  blogPosts           BlogPost[]
  adCreatives         AdCreative[]

  // Universal Temporal Platform (UTP)
  timeSystems           TimeSystem[]
  temporalPatterns      TemporalPattern[]
  temporalExpressions   TemporalExpression[]
  temporalRanges        TemporalRange[]
  temporalRules         TemporalRule[]
  temporalDependencies  TemporalDependency[]
  calendars             Calendar[]
  calendarShares        CalendarShare[]
  scheduledEvents       ScheduledEvent[]
  resources             Resource[]
  resourceBookings      ResourceBooking[]
  availabilityProfiles  AvailabilityProfile[]
  appointments          Appointment[]
  appointmentSlots      AppointmentSlot[]
  shifts                Shift[]
  shiftAssignments      ShiftAssignment[]
  coverageRequirements  CoverageRequirement[]
  temporalTriggers      TemporalTrigger[]
  executionPlans        ExecutionPlan[]
  temporalVersions      TemporalVersion[]
  temporalEventLogs     TemporalEventLog[]
  holidayCalendars      HolidayCalendar[]
  fiscalCalendars       FiscalCalendar[]
  libraryTemplates      LibraryTemplate[]
  temporalConfiguration TemporalConfiguration?
  streamTransports      StreamTransport[]
  marketplaceListings   MarketplaceListing[]
  widgetEmbeds          WidgetEmbed[]
  calendarConnectors    CalendarConnectorTemplate[]
  calendarConnections   CalendarConnection[]
  usageEvents           UsageEvent[]
  branding              OrgBranding?
  localeCatalogs        LocaleCatalog[]

  // UCIP composition layer (restored from migrations)
  attributionResults    AttributionResult[]
  attributionTouches    AttributionTouch[]
  autonomousActions     AutonomousAction[]
  autonomousPolicys     AutonomousPolicy[]
  budgetPlans           BudgetPlan[]
  campaignTemplates     CampaignTemplate[]
  campaignVersions      CampaignVersion[]
  channelOptimizations  ChannelOptimization[]
  clientKycs            ClientKyc[]
  commissionEvents      CommissionEvent[]
  commissionRules       CommissionRule[]
  complianceChecks      ComplianceCheck[]
  compliancePolicys     CompliancePolicy[]
  contentScores         ContentScore[]
  contentTranslations   ContentTranslation[]
  contentVersions       ContentVersion[]
  contracts             Contract[]
  conversionPredictions ConversionPrediction[]
  decisionPolicys       DecisionPolicy[]
  digitalTwinModels     DigitalTwinModel[]
  dynamicPriceRules     DynamicPriceRule[]
  experiments           Experiment[]
  experimentAssignments ExperimentAssignment[]
  fraudSignals          FraudSignal[]
  funnels               Funnel[]
  funnelSnapshots       FunnelSnapshot[]
  journeys              Journey[]
  journeyRuns           JourneyRun[]
  knowledgeItems        KnowledgeItem[]
  kpiDefs               KpiDef[]
  kpiSnapshots          KpiSnapshot[]
  lookalikeJobs         LookalikeJob[]
  loyaltyAccounts       LoyaltyAccount[]
  loyaltyTxns           LoyaltyTxn[]
  optimizationRuns      OptimizationRun[]
  orgHierarchys         OrgHierarchy[]
  outcomeEvents         OutcomeEvent[]
  portalInvites         PortalInvite[]
  portalMembers         PortalMember[]
  predictiveScores      PredictiveScore[]
  recipientPreferences  RecipientPreference[]
  ruleDefinitions       RuleDefinition[]
  searchIndexRows       SearchIndexRow[]
  settlements           Settlement[]
  vouchers              Voucher[]

  @@index([status])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  rank        Int
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions        RolePermission[]
  memberships        Membership[]
  projectMemberRoles ProjectMember[]

  @@index([rank])
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  module      String
  action      String
  name        String
  description String?

  roles RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id        String           @id @default(cuid())
  orgId     String
  userId    String
  roleId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role         @relation(fields: [roleId], references: [id])

  @@unique([orgId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Reference data (DB-driven dictionaries — nothing business-side hardcoded)
// ---------------------------------------------------------------------------

model Currency {
  code       String  @id
  name       String
  symbol     String
  minorUnits Int     @default(2)
  active     Boolean @default(true)

  organizations Organization[] @relation("OrgDefaultCurrency")
  clients       Client[]
  projects      Project[]
  serviceItems  ServiceItem[]
  quotes        Quote[]
  invoices      Invoice[]
  payments      Payment[]
  plans         Plan[]
  campaigns     Campaign[]
  expenses      Expense[]
  leads         Lead[]

  @@index([active])
}

enum TaxRateKind {
  GST_INTRA
  GST_INTER
  FLAT
  TDS
  NONE
}

model TaxRate {
  id                   String      @id @default(cuid())
  orgId                String?
  code                 String
  name                 String
  kind                 TaxRateKind
  rateBps              Int
  gstCategory          String?
  isDefault            Boolean     @default(false)
  active               Boolean     @default(true)
  parentGroupTaxRateId String?

  org          Organization?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parentGroup  TaxRate?          @relation("TaxComponentPair", fields: [parentGroupTaxRateId], references: [id])
  components   TaxRate[]         @relation("TaxComponentPair")
  invoiceLines InvoiceLineItem[]
  quoteLines   QuoteLineItem[]
  serviceItems ServiceItem[]

  @@unique([orgId, code])
}

enum CategoryKind {
  SERVICE
  INDUSTRY
  LEAD_SOURCE
  EXPENSE_TYPE
  CAMPAIGN_CHANNEL
  PROJECT_TYPE
}

model Category {
  id        String       @id @default(cuid())
  orgId     String?
  kind      CategoryKind
  code      String
  name      String
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  meta      Json?

  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  services  ServiceItem[]
  clients   Client[]
  leads     Lead[]
  expenses  Expense[]
  campaigns Campaign[]
  projects  Project[]

  @@unique([orgId, kind, code])
  @@index([kind, active])
}

model PipelineStage {
  id                String   @id @default(cuid())
  orgId             String
  code              String
  name              String
  winProbabilityBps Int      @default(0)
  sortOrder         Int
  isTerminalWon     Boolean  @default(false)
  isTerminalLost    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads Lead[]

  @@unique([orgId, code])
  @@index([orgId, sortOrder])
}

enum DocKind {
  QUOTE
  INVOICE
  PAYMENT
}

model DocumentSequence {
  id        String  @id @default(cuid())
  orgId     String
  kind      DocKind
  pattern   String
  prefix    String
  padding   Int     @default(4)
  nextValue Int     @default(1)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, kind])
}

model GeoLocation {
  id          String  @id @default(cuid())
  orgId       String?
  name        String
  googleId    String?
  countryCode String?
  latE7       Int? // latitude × 10^7 (integer doctrine — no floats anywhere)
  lngE7       Int? // longitude × 10^7
  active      Boolean @default(true)

  org      Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  keywords Keyword[]     @relation("KeywordLocation")

  @@unique([orgId, name])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

enum ClientStatus {
  PROSPECT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Client {
  id               String       @id @default(cuid())
  orgId            String
  name             String
  legalName        String?
  status           ClientStatus @default(ACTIVE)
  industryId       String?
  website          String?
  gstin            String?
  taxExempt        Boolean      @default(false)
  phone            String?
  billingEmail     String?
  currencyCode     String
  paymentTermsDays Int          @default(15)
  customFields     Json?
  addressLine1     String?
  city             String?
  state            String?
  postalCode       String?
  country          String       @default("IN")
  ownerId          String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  industry          Category?          @relation(fields: [industryId], references: [id])
  currency          Currency           @relation(fields: [currencyCode], references: [code])
  owner             User               @relation("ClientOwner", fields: [ownerId], references: [id])
  contacts          Contact[]
  leads             Lead[]
  projects          Project[]
  quotes            Quote[]
  invoices          Invoice[]
  payments          Payment[]
  expenses          Expense[]
  campaigns         Campaign[]
  socialConnections SocialConnection[]
  offers            Offer[]
  webProperties     WebProperty[]
  contentPosts      ContentPost[]
  trackedLinks      TrackedLink[]
  emailCampaigns    EmailCampaign[]
  brandVoices       BrandVoice[]
  blogPosts         BlogPost[]
  audiences         Audience[]
  onboardingSteps   OnboardingStep[]

  // UCIP composition layer (restored from migrations)
  clientKyc ClientKyc?
  contracts Contract[]

  @@unique([orgId, name])
  @@index([orgId, status])
  @@index([orgId, ownerId])
}

model Contact {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  email       String?
  phone       String?
  designation String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum NoteEntityType {
  CLIENT
  LEAD
  PROJECT
  TASK
  INVOICE
  QUOTE
  CAMPAIGN
  SUBSCRIPTION
}

model Note {
  id         String         @id @default(cuid())
  orgId      String
  entityType NoteEntityType
  entityId   String
  authorId   String
  body       String
  createdAt  DateTime       @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author User         @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([orgId, entityType, entityId])
}

model Lead {
  id                String   @id @default(cuid())
  orgId             String
  name              String
  company           String?
  email             String?
  phone             String?
  website           String?
  sourceId          String?
  stageId           String
  budgetMinor       BigInt?
  currencyCode      String
  message           String?
  assignedToId      String?
  convertedClientId String?
  lostReason        String?
  stageChangedAt    DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org             Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  source          Category?     @relation(fields: [sourceId], references: [id])
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  currency        Currency      @relation(fields: [currencyCode], references: [code])
  convertedClient Client?       @relation(fields: [convertedClientId], references: [id])

  @@index([orgId, stageId])
  @@index([orgId, createdAt])
}

// ---------------------------------------------------------------------------
// Delivery
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id                   String        @id @default(cuid())
  orgId                String
  clientId             String
  name                 String
  summary              String?
  status               ProjectStatus @default(PLANNING)
  typeId               String?
  ownerId              String
  startDate            DateTime?
  endDate              DateTime?
  budgetMinor          BigInt?
  currencyCode         String
  hourlyRateMinor      BigInt?
  retainerMonthlyMinor BigInt?
  domainUrl            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  org           Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type          Category?        @relation(fields: [typeId], references: [id])
  owner         User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  currency      Currency         @relation(fields: [currencyCode], references: [code])
  members       ProjectMember[]
  tasks         Task[]
  timeEntries   TimeEntry[]
  expenses      Expense[]
  rankSnapshots RankSnapshot[]
  siteAudits    SiteAudit[]
  campaigns     Campaign[]
  keywords      ProjectKeyword[]
  contentPosts  ContentPost[]
  blogPosts     BlogPost[]

  @@index([orgId, status])
  @@index([clientId])
}

model ProjectMember {
  projectId String
  userId    String
  roleRefId String?
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef Role?   @relation(fields: [roleRefId], references: [id])

  @@id([projectId, userId])
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id               String       @id @default(cuid())
  orgId            String
  projectId        String
  title            String
  description      String?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  assigneeId       String?
  dueDate          DateTime?
  estimatedMinutes Int?
  completedAt      DateTime?
  serviceItemId    String?
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  serviceItem ServiceItem? @relation(fields: [serviceItemId], references: [id])
  timeEntries TimeEntry[]

  @@index([projectId, status])
  @@index([orgId, assigneeId, status])
}

model TimeEntry {
  id            String   @id @default(cuid())
  orgId         String
  projectId     String
  taskId        String?
  userId        String
  date          DateTime
  minutes       Int
  billable      Boolean  @default(true)
  rateMinor     BigInt?
  invoiceLineId String?
  description   String?
  createdAt     DateTime @default(now())

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user        User             @relation(fields: [userId], references: [id])
  invoiceLine InvoiceLineItem? @relation(fields: [invoiceLineId], references: [id])

  @@index([orgId, projectId])
  @@index([orgId, userId, date])
  @@index([invoiceLineId])
}

model Expense {
  id            String   @id @default(cuid())
  orgId         String
  projectId     String
  clientId      String?
  categoryId    String?
  date          DateTime
  amountMinor   BigInt
  currencyCode  String
  billable      Boolean  @default(true)
  description   String?
  invoiceLineId String?
  createdAt     DateTime @default(now())

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client      Client?          @relation(fields: [clientId], references: [id])
  category    Category?        @relation(fields: [categoryId], references: [id])
  currency    Currency         @relation(fields: [currencyCode], references: [code])
  invoiceLine InvoiceLineItem? @relation(fields: [invoiceLineId], references: [id])

  @@index([orgId, projectId])
  @@index([invoiceLineId])
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

enum UnitType {
  HOUR
  PIECE
  MONTH
  PROJECT
  RETAINER
}

model ServiceItem {
  id           String   @id @default(cuid())
  orgId        String
  categoryId   String?
  code         String
  name         String
  description  String?
  unit         UnitType @default(PIECE)
  priceMinor   BigInt
  currencyCode String
  taxable      Boolean  @default(true)
  taxRateId    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category     Category?         @relation(fields: [categoryId], references: [id])
  currency     Currency          @relation(fields: [currencyCode], references: [code])
  taxRate      TaxRate?          @relation(fields: [taxRateId], references: [id])
  quoteLines   QuoteLineItem[]
  invoiceLines InvoiceLineItem[]
  tasks        Task[]

  @@unique([orgId, code])
  @@index([orgId, active])
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

model Quote {
  id                 String      @id @default(cuid())
  orgId              String
  clientId           String
  number             String
  status             QuoteStatus @default(DRAFT)
  currencyCode       String
  issueDate          DateTime    @default(now())
  validUntil         DateTime?
  discountMinor      BigInt      @default(0)
  subtotalMinor      BigInt      @default(0)
  taxMinor           BigInt      @default(0)
  totalMinor         BigInt      @default(0)
  terms              String?
  notes              String?
  approvedById       String?
  approvedAt         DateTime?
  convertedInvoiceId String?     @unique
  createdById        String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  org              Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client           Client          @relation(fields: [clientId], references: [id])
  currency         Currency        @relation(fields: [currencyCode], references: [code])
  approvedBy       User?           @relation("QuoteApprover", fields: [approvedById], references: [id])
  createdBy        User            @relation("QuoteCreator", fields: [createdById], references: [id])
  lines            QuoteLineItem[]
