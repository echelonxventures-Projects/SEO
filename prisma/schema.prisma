  lookalikeJobs LookalikeJob[]

  @@unique([orgId, name])
  @@index([orgId, status])
}

model AudienceMember {
  id              String        @id @default(cuid())
  audienceId      String
  orgId           String
  identityKey     String // sha256 of normalized email|phone|externalId
  email           String?
  emailNormalized String?
  phone           String?
  name            String?
  company         String?
  tags            String[]
  consent         ConsentStatus @default(IMPORTED_LEGACY)
  customFields    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  audience   Audience           @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  identities AudienceIdentity[]

  @@unique([audienceId, identityKey])
  @@index([orgId])
}

enum FlightStatus {
  DRAFT
  APPROVED
  LIVE
  PAUSED
  ENDED
  CANCELLED
}

model CampaignFlight {
  id             String       @id @default(cuid())
  campaignId     String
  orgId          String
  channelId      String
  audienceId     String?
  patternId      String? // UTP temporal asset consumed for cadence (supersedes legacy cadence JSON)
  startsAt       DateTime
  endsAt         DateTime
  timezone       String       @default("Asia/Kolkata")
  budgetMinor    BigInt?
  cadence        Json? // { days:[1,3,5], time:"10:00" } — social slot materializer
  status         FlightStatus @default(DRAFT)
  notes          String?
  slotsGenerated Int          @default(0)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel  Channel          @relation(fields: [channelId], references: [id])
  audience Audience?        @relation(fields: [audienceId], references: [id])
  pattern  TemporalPattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)

  @@index([orgId, startsAt])
  @@index([campaignId])
  @@index([status, startsAt, endsAt])
}

// ===========================================================================
// CONNECTOR TEMPLATES — social/ad platforms as data, not code
// ===========================================================================

enum ConnectorProtocol {
  OAUTH2_CODE // standard authorization-code (config: token/me/publish endpoints)
  OAUTH2_PKCE // authorization-code + PKCE
  BUILTIN // implemented by a code adapter (special OAuth flows); endpoints still configurable
}

model ConnectorTemplate {
  id           String            @id @default(cuid())
  orgId        String? // null = global (platform-shipped) catalog
  key          String // lowercase unique: facebook, x, linkedin, mastodon, threads…
  name         String
  protocol     ConnectorProtocol @default(OAUTH2_CODE)
  capabilities String[] // publish, read_metrics, direct_messages…
  authorizeUrl String?
  tokenUrl     String?
  apiBase      String?
  scopes       String[]
  // endpoint templates + response field mappings for the generic engine:
  // { mePath, publishPath, idPath:"data.id", handlePath:"data.username",
  //   picturePath, accessTokenPath:"access_token", refreshTokenPath,
  //   expiresInPath, authStyle:"basic"|"body", publishBody:"{"text":"{{text}}"}",
  //   meHeaders:{Authorization:"Bearer {token}"}, externalUrlPath }
  config       Json
  docsUrl      String?
  icon         String?
  builtin      Boolean           @default(false) // true = code adapter exists (protocol quirks)
  active       Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  org Organization? @relation("ConnectorTemplateOrg", fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([active, sortOrder])
}

// ===========================================================================
// UCOS BACKBONE: DOMAIN EVENTS, OFFERS, ORCHESTRATOR LIFECYCLE
// ===========================================================================

// --- Cross-domain event architecture (§13) ---------------------------------

model DomainEvent {
  id            String    @id @default(cuid())
  orgId         String?
  type          String // "campaign.launched", "offer.redeemed"…
  aggregateType String
  aggregateId   String
  payload       Json
  occurredAt    DateTime  @default(now())
  deletedAt     DateTime? // outbox consumption marker (row retained = audit)

  deliveries   EventDelivery[]
  triggerFires TriggerFire[]

  @@index([type, occurredAt])
  @@index([orgId, occurredAt])
  @@index([deletedAt])
}

model EventSubscription {
  id         String   @id @default(cuid())
  orgId      String? // null = platform subscriber
  eventMatch String // exact type or prefix with "*" e.g. "offer.*"
  url        String // https-only webhook target
  label      String
  secretEnc  Json
  active     Boolean  @default(true)
  lastError  String?
  failCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org    Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events EventDelivery[]

  @@index([active])
}

model EventDelivery {
  id             String   @id @default(cuid())
  eventId        String
  subscriptionId String
  status         String // PENDING | SENT | FAILED
  attempts       Int      @default(0)
  responseCode   Int?
  error          String?
  at             DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event        DomainEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscription EventSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([eventId, subscriptionId])
  @@index([status, at])
}

// --- Offer domain (§10) ------------------------------------------------------

enum OfferKind {
  DISCOUNT
  COUPON
  PROMOTION
  BUNDLE
  REFERRAL
  LOYALTY
  MEMBERSHIP
}

enum OfferValueType {
  PERCENT
  AMOUNT
  FREE_ITEM
  POINTS
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  ACTIVE
  EXPIRED
  ARCHIVED
}

model Offer {
  id                String         @id @default(cuid())
  orgId             String
  clientId          String?
  code              String
  name              String
  description       String?
  kind              OfferKind      @default(COUPON)
  valueType         OfferValueType @default(PERCENT)
  value             Int // percent bps (1250 = 12.5%) or minor units or points
  minSpendMinor     BigInt?
  maxRedemptions    Int?
  perRecipientLimit Int?           @default(1)
  startsAt          DateTime?
  endsAt            DateTime?
  appliesTo         Json? // {serviceItemIds, clientIds, campaignIds}
  terms             String?
  status            OfferStatus    @default(DRAFT)
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  publishedAt       DateTime?
  activatedAt       DateTime?
  expiredAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client      Client?           @relation(fields: [clientId], references: [id])
  redemptions OfferRedemption[]
  campaigns   CampaignOffer[]

  // UCIP composition layer (restored from migrations)
  vouchers Voucher[]

  @@unique([orgId, code])
  @@index([orgId, status])
}

model OfferRedemption {
  id            String   @id @default(cuid())
  offerId       String
  orgId         String
  recipientKey  String // sha256 email or client:<id> — caps & dedupe
  email         String?
  clientId      String?
  invoiceId     String?
  campaignId    String?
  discountMinor BigInt
  at            DateTime @default(now())

  offer   Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
