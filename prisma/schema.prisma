// ---------------------------------------------------------------------------
// UTP event-stream transports — the Kafka/Pulsar/Event-Fabric seam, as data.
// The TemporalEventLog is the source of truth; transports push it to external
// streaming fabrics (HTTP sink adapters ship working; brokers register here).
// ---------------------------------------------------------------------------

enum TransportKind {
  HTTP_SINK // signed push (HMAC-SHA256) to any fabric receiver / webhook bridge
  KAFKA // broker adapter (connection string + topic in url field)
  PULSAR // broker adapter
  EVENT_MESH
}

model StreamTransport {
  id          String        @id @default(cuid())
  orgId       String? // null = platform fabric (federates every workspace)
  name        String
  kind        TransportKind @default(HTTP_SINK)
  url         String
  secretEnc   Json // HMAC key, AES-256-GCM envelope-encrypted at rest
  eventMatch  String        @default("*") // "*"/"appointment.*"/"pattern.*"...
  cursorAt    DateTime      @default(now())
  cursorId    String        @default("") // at+id pair = resumable stream cursor
  active      Boolean       @default(false) // fill-in-the-blank: inactive placeholder until configured
  failCount   Int           @default(0)
  lastError   String?
  lastSentAt  DateTime?
  sentCount   Int           @default(0)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([active])
}

