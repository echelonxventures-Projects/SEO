  textModel       String       @default("gpt-4o-mini")
  imageModel      String       @default("gpt-image-1")
  audioModel      String       @default("tts-1")
  defaultVoice    String       @default("alloy")
  // Routing policy — pure data, no code branches:
  // candidates are tried in (org-first, priority asc) order; a config whose
  // requiredFeature is set is only eligible when the tenant's active plan
  // includes that feature. null = freely available to every workspace.
  priority        Int          @default(100)
  requiredFeature FeatureCode?
  active          Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

