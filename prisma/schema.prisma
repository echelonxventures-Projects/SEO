// ===========================================================================
// UNIVERSAL TEMPORAL PLATFORM (UTP) — Enterprise Calendar & Temporal OS
// ---------------------------------------------------------------------------
// Core principle: schedules are NOT attributes of events. Events, campaigns,
// workflows, content, resources, clients, finance, notifications and agents
// all CONSUME reusable Temporal Assets owned by this domain.
//
// Money analog: durations/offsets are integer seconds/minutes (no floats);
// absolute instants are UTC DateTime; sub-second instants use BigInt micros.
// Every mutation is versioned + appended to the immutable TemporalEventLog.
// ===========================================================================

enum TimeSystemKind {
  LINEAR_OFFSET // civil time = UTC + fixed offset minutes
  ROTATION // body-relative sol/day counting (e.g. Mars Sol — Darian-style)
  CUSTOM // user-defined epoch + unit transform
}

model TimeSystem {
  id               String         @id @default(cuid())
  orgId            String? // null = global
  code             String // UTC, IST, UTC+5:30, MARS_SOL, MOON_TIME, CUSTOM#...
  name             String
  kind             TimeSystemKind @default(LINEAR_OFFSET)
  utcOffsetMinutes Int            @default(0)
  unitSeconds      Int            @default(86400) // length of one "day"/sol in SI seconds
  epochMicros      BigInt         @default(0) // system epoch in SI Unix micros (rotation/custom)
  label            String // formatting hint: "sol", "day", "cycle"
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  patterns  TemporalPattern[]
  calendars Calendar[]

  @@unique([orgId, code])
  @@index([active])
}

enum TemporalPatternType {
  TIME
  DATE
  DATE_RANGE
  TIME_RANGE
  DURATION
  WINDOW
  TRIGGER
  CONSTRAINT
  DEPENDENCY
  COMPOSITE
}

enum RecurrenceFreq {
  NONE
  SECONDLY
  MINUTELY
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum PatternStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  ARCHIVED
}

model TemporalPattern {
  id           String              @id @default(cuid())
  orgId        String? // null = platform library asset
  name         String
  description  String?
  type         TemporalPatternType @default(WINDOW)
  freq         RecurrenceFreq      @default(NONE)
  // Reusable temporal asset. spec: the declarative recurrence definition.
  // { interval, byWeekDay:[0-6], byMonthDay:[], bySetPos, byMonth:[], until, count,
  //   time:"09:00", durationMinutes, windowStart/windowEnd, setPos, weekStartsOn, monthPattern:"FIRST_MONDAY" }
  spec         Json
  dsl          String? // human/DSL source, e.g. "EVERY WEEKDAY 09:00"
  timezone     String              @default("Asia/Kolkata")
  timeSystemId String?
  status       PatternStatus       @default(ACTIVE)
  version      Int                 @default(1)
  isLibrary    Boolean             @default(false)
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  org                  Organization?         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  timeSystem           TimeSystem?           @relation(fields: [timeSystemId], references: [id], onDelete: SetNull)
  expressions          TemporalExpression[]
  calendars            Calendar[]
  events               ScheduledEvent[]
  availabilityProfiles AvailabilityProfile[]
  flights              CampaignFlight[]
  reports              Report[]
  triggers             TemporalTrigger[]

  @@index([orgId, status])
  @@index([isLibrary])
}

enum ExpressionStatus {
  UNVALIDATED
  VALID
  INVALID
  OPTIMIZED
}

model TemporalExpression {
  id          String           @id @default(cuid())
  orgId       String?
  patternId   String
  source      String // raw DSL text
  // ast: compiler output. { type, anchor, offset, unit, recurrence:{...}, calendarMask, normalized }
  ast         Json             @default("{}")
  diagnostics Json             @default("[]") // validator messages [{level,code,message}]
  // plan: execution plan (materialization strategy). { expansion:"bounded|streaming", stepSeconds, horizon }
  plan        Json             @default("{}")
  status      ExpressionStatus @default(UNVALIDATED)
  checksum    String // sha256 of normalized source (idempotent compile)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  org     Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pattern TemporalPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([patternId, checksum])
  @@index([orgId])
}

enum RangeKind {
  ABSOLUTE
