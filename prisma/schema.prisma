  unitPriceMinor BigInt
  discountBps    Int     @default(0)
  taxRateId      String?
  taxBps         Int     @default(0)
  lineTotalMinor BigInt
  sortOrder      Int     @default(0)

  quote        Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceItem  ServiceItem?      @relation(fields: [serviceItemId], references: [id])
  taxRate      TaxRate?          @relation(fields: [taxRateId], references: [id])
  invoiceLines InvoiceLineItem[]

  @@index([quoteId])
}

enum InvoicePartyKind {
  CLIENT
  TENANT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id                 String           @id @default(cuid())
  orgId              String
  partyKind          InvoicePartyKind @default(CLIENT)
  clientId           String?
  tenantId           String?
  subscriptionId     String?
  number             String
  status             InvoiceStatus    @default(DRAFT)
  currencyCode       String
  issueDate          DateTime         @default(now())
  dueDate            DateTime?
  discountMinor      BigInt           @default(0)
  subtotalMinor      BigInt           @default(0)
  taxMinor           BigInt           @default(0)
  totalMinor         BigInt           @default(0)
  paidMinor          BigInt           @default(0)
  taxBreakdown       Json?
  notes              String?
  terms              String?
  quoteId            String?
  createdByUserId    String
  voidedAt           DateTime?
  voidReason         String?
  sentAt             DateTime?
  checkoutToken      String?          @unique
  gatewayCheckoutRef String? // provider-side checkout/link id for reconciliation
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tenant           Organization?     @relation("TenantBilling", fields: [tenantId], references: [id])
  client           Client?           @relation(fields: [clientId], references: [id])
  subscription     Subscription?     @relation(fields: [subscriptionId], references: [id])
  currency         Currency          @relation(fields: [currencyCode], references: [code])
  quote            Quote?            @relation("QuoteSource", fields: [quoteId], references: [id])
  convertedFrom    Quote?            @relation("InvoiceConvertedFromQuote")
  createdBy        User              @relation("InvoiceCreator", fields: [createdByUserId], references: [id])
  lines            InvoiceLineItem[]
  payments         Payment[]
  offerRedemptions OfferRedemption[]

  @@unique([orgId, number])
  @@index([orgId, status, dueDate])
  @@index([clientId])
  @@index([tenantId, status])
  @@index([partyKind, status])
  @@index([subscriptionId])
}

enum InvoiceLineSourceType {
  MANUAL
  QUOTE
  TIME
  EXPENSE
  SUBSCRIPTION
}

model InvoiceLineItem {
  id                String                @id @default(cuid())
  invoiceId         String
  serviceItemId     String?
  sourceType        InvoiceLineSourceType @default(MANUAL)
  sourceQuoteLineId String?
  description       String
  qtyHundredths     Int
  unitPriceMinor    BigInt
  discountBps       Int                   @default(0)
  taxRateId         String?
  taxBps            Int                   @default(0)
  lineTotalMinor    BigInt
  sortOrder         Int                   @default(0)

  invoice     Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem?   @relation(fields: [serviceItemId], references: [id])
  quoteLine   QuoteLineItem? @relation(fields: [sourceQuoteLineId], references: [id])
  taxRate     TaxRate?       @relation(fields: [taxRateId], references: [id])
  timeEntries TimeEntry[]
  expenses    Expense[]

  @@index([invoiceId])
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CARD
  NETBANKING
  WALLET
  CASH
  CHEQUE
  GATEWAY
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  orgId             String
  invoiceId         String?
  clientId          String?
  number            String
  method            PaymentMethod
  status            PaymentStatus @default(COMPLETED)
  amountMinor       BigInt
  refundedMinor     BigInt        @default(0)
  currencyCode      String
  paidAt            DateTime
  reference         String?
  note              String?
  gatewayConfigId   String?
  gatewayPaymentRef String?
  recordedByUserId  String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice    Invoice?       @relation(fields: [invoiceId], references: [id])
  client     Client?        @relation(fields: [clientId], references: [id])
  currency   Currency       @relation(fields: [currencyCode], references: [code])
  gateway    GatewayConfig? @relation(fields: [gatewayConfigId], references: [id])
  recordedBy User           @relation("PaymentRecorder", fields: [recordedByUserId], references: [id])
  refunds    Refund[]

  @@unique([orgId, number])
  @@index([invoiceId])
  @@index([orgId, paidAt])
  @@index([gatewayPaymentRef])
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

model Refund {
  id               String       @id @default(cuid())
  orgId            String
  paymentId        String
  amountMinor      BigInt
  status           RefundStatus @default(PENDING)
  reason           String?
  gatewayRefundRef String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// SaaS subscription billing
// ---------------------------------------------------------------------------

enum PlanInterval {
  MONTH
  QUARTER
  YEAR
}

enum PlanStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model Plan {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  priceMinor   BigInt
  currencyCode String
  interval     PlanInterval
  trialDays    Int          @default(0)
  maxSeats     Int
  maxClients   Int
  maxProjects  Int
  maxKeywords  Int
  status       PlanStatus   @default(DRAFT)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  currency      Currency           @relation(fields: [currencyCode], references: [code])
  features      PlanFeature[]
  meteredPrices PlanMeteredPrice[]
  subscriptions Subscription[]

  @@index([status, sortOrder])
}

enum FeatureCode {
  RANK_TRACKING
  SITE_AUDIT
  BACKLINK_INDEX
  CAMPAIGN_METRICS
  TIME_TRACKING
  EXPENSE_TRACKING
  QUOTES
  INVOICING
  ONLINE_COLLECT
  REPORT_BUILDER
  API_ACCESS
  WHITE_LABEL
  AI_PREMIUM
}

model PlanFeature {
  planId      String
  featureCode FeatureCode
  limitValue  BigInt?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureCode])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  CANCELLED
  EXPIRED
}

enum BillingCycleStatus {
  PENDING
  INVOICED
  PAID
  FAILED
  ABANDONED
}

model Subscription {
  id                 String             @id @default(cuid())
  orgId              String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  seats              Int                @default(1)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan     Plan           @relation(fields: [planId], references: [id])
  invoices Invoice[]
  cycles   BillingCycle[]

  @@index([orgId, status])
  @@index([status, currentPeriodEnd])
}

model BillingCycle {
  id             String             @id @default(cuid())
  subscriptionId String
  periodStart    DateTime
  periodEnd      DateTime
  status         BillingCycleStatus @default(PENDING)
  invoiceId      String?
  attempts       Int                @default(0)
  lastAttemptAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, periodStart])
  @@index([status])
}

