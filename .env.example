# OmniMark environment — copy to .env and fill real values.
# Prisma 7 reads DATABASE_URL via prisma.config.ts (dotenv).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/omnimark"

# Canonical app URL (used in absolute links, webhooks, CSRF origin checks)
APP_URL="http://localhost:3000"

# Node env: development | production
NODE_ENV="development"

# Current active data-encryption key version
OMNI_ENCRYPTION_KEY_VERSION="1"
# JSON map of keyVersion -> base64 256-bit key (envelope encryption for secrets at rest)
OMNI_ENCRYPTION_KEYS='{"1":"REPLACE_WITH_BASE64_32_BYTES"}'

# HMAC secret for signed tokens (invitations, password resets, invoice checkout links)
OMNI_TOKEN_SECRET="REPLACE_WITH_BASE64_32_BYTES"

# Postgres password for docker compose (db + app services)
PG_PASSWORD=""

# Number of reverse proxies in front of the app that append to
# X-Forwarded-For. Client IP = the entry this many hops from the right, so the
# client can't spoof it. 1 = behind one proxy/LB (recommended for production;
# Next.js alone does not append to the header). 0 = ignore forwarding headers.
OMNI_TRUSTED_PROXY_HOPS="1"

# Outbound requests to workspace-configured URLs (webhooks, connectors, OAuth
# hosts, AI base URLs, SEO crawls) refuse private/internal addresses (SSRF
# guard). Unset = refuse in production, allow in dev. "1" allows (local
# receivers only — never in a shared production), "0" refuses everywhere.
OMNI_ALLOW_PRIVATE_EGRESS=""

# Rate limiting (token bucket) — conservative defaults are applied if unset
OMNI_RATE_AUTH_PER_MIN="10"
OMNI_RATE_API_PER_MIN="120"

# bcrypt cost factor for password hashing
OMNI_BCRYPT_ROUNDS="12"

# Optional AI provider keys — the seeder registers any that are present as
# platform routing entries (free tiers first; premium gated to plans with
# AI_PREMIUM). All can also be managed at runtime in Settings -> AI Studio.
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional SMTP for transactional email (password reset, invoices).
# If unset, emails are logged to stdout (never silently dropped).
SMTP_URL=""
MAIL_FROM=""

# Public base URL used for payment-gateway webhook callbacks (https in prod)
OMNI_WEBHOOK_BASE_URL=""

# Facebook Graph API version used by the social adapter (overridable per app
# in the UI without redeploy)
OMNI_GRAPH_VERSION="v21.0"

# Bootstrap login created by `npm run db:seed`. This user is a PLATFORM ADMIN.
# REQUIRED in production (>= 12 chars, not the demo default) — seed refuses
# to run otherwise. In dev it defaults to founder@aithink.india / DemoPassword#1.
DEMO_EMAIL=""
DEMO_PASSWORD=""

# Sample data: "1" forces the demo workspace data (even in prod — don't),
# "0" skips it in dev. Unset = on in dev, off in production.
OMNI_SEED_DEMO=""

# Shared secret for internal scheduled jobs (POST /api/v1/cron/*) and the
# /api/v1/monitoring/* endpoints. The scheduler (`npm run cron`, or the
# docker compose `scheduler` service) uses it to drive every job.
CRON_SECRET=""
